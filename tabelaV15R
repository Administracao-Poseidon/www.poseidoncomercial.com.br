<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Poseidon Tabela Interna</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    body {
      max-width: 1200px;
      margin: 0 auto;
      padding: 12px;
      background: #f5f5f5;
      min-height: 100vh;
    }

    h1 {
      color: #2c3e50;
      text-align: center;
      margin: 15px 0 25px;
      font-size: clamp(1.3rem, 4vw, 1.8rem);
    }

    h3 {
      color: #2c3e50;
      margin-bottom: 15px;
      font-size: clamp(1rem, 3vw, 1.25rem);
    }

    .form-box, .tabela-box {
      background: white;
      padding: clamp(15px, 4vw, 25px);
      border-radius: 10px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.08);
      margin-bottom: 25px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }

    .grupo {
      display: flex;
      flex-direction: column;
    }

    label {
      font-weight: 600;
      margin-bottom: 6px;
      color: #34495e;
      font-size: 0.95rem;
    }

    input {
      padding: 12px 10px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 1rem;
      transition: border 0.2s;
    }

    input:focus {
      outline: none;
      border-color: #2980b9;
    }

    .valores {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin: 15px 0;
    }

    .valores input {
      background: #e8f4fd;
      font-weight: bold;
      color: #2980b9;
    }

    button {
      background: #27ae60;
      color: white;
      border: none;
      padding: 14px;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
      width: 100%;
      margin-top: 8px;
      touch-action: manipulation;
    }

    button:hover { background: #219653; }
    button:active { background: #1e8449; }

    .apagar {
      background: #e74c3c;
      padding: 8px 10px;
      font-size: 0.85rem;
      width: 100%;
      border-radius: 6px;
      margin: 2px 0;
    }
    .apagar:hover { background: #c0392b; }

    .mensagem {
      margin-top: 12px;
      padding: 12px;
      border-radius: 6px;
      display: none;
      font-size: 0.95rem;
    }
    .sucesso { background: #d4edda; color: #155724; }
    .erro { background: #f8d7da; color: #721c24; }

    .tabela-container {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 6px;
      border: 1px solid #eee;
    }

    table {
      width: 100%;
      min-width: 800px;
      border-collapse: collapse;
    }

    th, td {
      padding: 10px 8px;
      text-align: left;
      border-bottom: 1px solid #eee;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    th {
      background: #2c3e50;
      color: white;
      font-weight: 600;
    }

    tr:hover { background: #f9f9f9; }
    tr:last-child td { border-bottom: none; }

    th:last-child, td:last-child {
      text-align: center;
      min-width: 130px;
    }

    /* Ajustes para telas MUITO pequenas */
    @media (max-width: 600px) {
      body { padding: 8px; }
      h1 { margin-top: 10px; margin-bottom: 18px; }
      .form-box, .tabela-box { padding: 15px; }
      th, td { padding: 8px 6px; font-size: 0.82rem; }
      .apagar { padding: 6px 4px; font-size: 0.78rem; }
    }
  </style>
</head>
<body>

<h1>📦 Poseidon Tabela Interna de Produtos e Preços</h1>

<div class="form-box">
  <h3>Cadastrar Novo Produto</h3>
  <form id="formProduto">
    <div class="form-grid">
      <div class="grupo">
        <label>Data</label>
        <input type="date" id="data" required="">
      </div>
      <div class="grupo">
        <label>Produto</label>
        <input type="text" id="produto" required="" placeholder="Nome do produto">
      </div>
      <div class="grupo">
        <label>Custo (R$)</label>
        <input type="number" step="0.01" id="custo" required="" placeholder="0,00" oninput="calcularPrecos()">
      </div>
    </div>

    <div class="valores">
      <div class="grupo">
        <label>Venda 50%</label>
        <input type="text" id="venda50" readonly="">
      </div>
      <div class="grupo">
        <label>Venda 70%</label>
        <input type="text" id="venda70" readonly="">
      </div>
      <div class="grupo">
        <label>Venda 100%</label>
        <input type="text" id="venda100" readonly="">
      </div>
    </div>

    <div class="form-grid">
      <div class="grupo">
        <label>Fornecedor</label>
        <input type="text" id="fornecedor" required="" placeholder="Nome da empresa">
      </div>
      <div class="grupo">
        <label>Contato</label>
        <input type="text" id="contato" required="" placeholder="Telefone/Email">
      </div>
    </div>

    <button type="submit">💾 Salvar na Planilha</button>
    <div id="mensagem" class="mensagem"></div>
  </form>
</div>

<div class="tabela-box">
  <h3>Registros da Planilha</h3>
  <div class="tabela-container">
    <table id="tabelaDados">
      <thead>
        <tr>
          <th>Data</th>
          <th>Produto</th>
          <th>Custo</th>
          <th>Venda 50%</th>
          <th>Venda 70%</th>
          <th>Venda 100%</th>
          <th>Fornecedor</th>
          <th>Contato</th>
          <th>Ação</th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="9">Carregando...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
const URL_SCRIPT = "https://script.google.com/macros/s/AKfycbxVIZEHxfIvnirsVN6QaDSyq-mhGyFxtIPQcOG1pvxrHMZVlJYMHLWskUKJiYUphIyF/exec";

// ✅ Formata data para DD/MM/AAAA
function formatarData(data) {
  if (!data) return "";
  const d = new Date(data);
  if (isNaN(d.getTime())) return data;
  const dia = String(d.getDate()).padStart(2, '0');
  const mes = String(d.getMonth() + 1).padStart(2, '0');
  const ano = d.getFullYear();
  return `${dia}/${mes}/${ano}`;
}

function calcularPrecos() {
  const custo = parseFloat(document.getElementById("custo").value) || 0;
  document.getElementById("venda50").value = (custo * 1.5).toFixed(2);
  document.getElementById("venda70").value = (custo * 1.7).toFixed(2);
  document.getElementById("venda100").value = (custo * 2).toFixed(2);
}

// Salvar produto
document.getElementById("formProduto").addEventListener("submit", async (e) => {
  e.preventDefault();
  const msg = document.getElementById("mensagem");
  msg.style.display = "none";

  const dataInput = document.getElementById("data").value;
  const dataFormatada = formatarData(dataInput);

  const dados = {
    data: dataFormatada,
    produto: document.getElementById("produto").value,
    custo: parseFloat(document.getElementById("custo").value).toFixed(2),
    venda50: document.getElementById("venda50").value,
    venda70: document.getElementById("venda70").value,
    venda100: document.getElementById("venda100").value,
    fornecedor: document.getElementById("fornecedor").value,
    contato: document.getElementById("contato").value
  };

  try {
    const resposta = await fetch(URL_SCRIPT, {
      method: "POST",
      headers: {"Content-Type": "text/plain;charset=utf-8"},
      redirect: "follow",
      body: JSON.stringify(dados)
    });

    const texto = await resposta.text();
    let resultado;
    try { resultado = JSON.parse(texto); }
    catch { throw new Error(`Servidor retornou: ${texto.substring(0,200)}`); }

    if (resultado.status === "sucesso") {
      msg.textContent = "✅ Produto salvo com sucesso!";
      msg.className = "mensagem sucesso";
      msg.style.display = "block";
      e.target.reset();
      document.getElementById("data").valueAsDate = new Date();
      carregarDados();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      throw new Error(resultado.mensagem || "Erro ao salvar");
    }
  } catch (erro) {
    msg.textContent = "❌ Erro: " + erro.message;
    msg.className = "mensagem erro";
    msg.style.display = "block";
  }
});

// ✅ Carrega dados com NÚMERO REAL da planilha
async function carregarDados() {
  const corpo = document.querySelector("#tabelaDados tbody");
  corpo.innerHTML = "<tr><td colspan='9'>Carregando...</td></tr>";

  try {
    const resposta = await fetch(URL_SCRIPT + "?t=" + Date.now(), {
      method: "GET",
      cache: "no-store"
    });
    const texto = await resposta.text();
    let dados;
    try { dados = JSON.parse(texto); }
    catch { throw new Error(`Resposta não é JSON: ${texto.substring(0,150)}...`); }

    if (!Array.isArray(dados)) throw new Error("Formato inválido");

    corpo.innerHTML = "";
    
    for (let i = 1; i < dados.length; i++) {
      const linha = dados[i];
      const numeroLinhaPlanilha = linha[8];
      
      const tr = document.createElement("tr");
      
      const tdData = document.createElement("td");
      tdData.textContent = formatarData(linha[0]);
      tr.appendChild(tdData);

      for (let j = 1; j < 8; j++) {
        const td = document.createElement("td");
        td.textContent = linha[j];
        tr.appendChild(td);
      }

      const tdAcao = document.createElement("td");
      const btnApagar = document.createElement("button");
      btnApagar.textContent = `🗑️ Apagar (linha ${numeroLinhaPlanilha})`;
      btnApagar.className = "apagar";
      btnApagar.onclick = () => apagarLinha(numeroLinhaPlanilha, linha[1]);
      tdAcao.appendChild(btnApagar);
      tr.appendChild(tdAcao);

      corpo.appendChild(tr);
    }
  } catch (erro) {
    corpo.innerHTML = `<tr><td colspan='9' style="color:red">Erro: ${erro.message}</td></tr>`;
  }
}

// ✅ Apaga com confirmação
async function apagarLinha(numeroLinha, nomeProduto) {
  const confirmacao = confirm(`Tem certeza que deseja apagar a LINHA ${numeroLinha}:\n"${nomeProduto}"?`);
  if (!confirmacao) return;

  try {
    const resposta = await fetch(URL_SCRIPT, {
      method: "POST",
      headers: {"Content-Type": "text/plain;charset=utf-8"},
      redirect: "follow",
      body: JSON.stringify({ acao: "apagar", linha: numeroLinha })
    });

    const texto = await resposta.text();
    let resultado;
    try { resultado = JSON.parse(texto); }
    catch { throw new Error(`Servidor retornou: ${texto.substring(0,200)}`); }

    if (resultado.status === "sucesso") {
      alert(`✅ ${resultado.mensagem}\nAtualizando...`);
      carregarDados();
    } else {
      throw new Error(resultado.mensagem || "Erro desconhecido");
    }
  } catch (erro) {
    alert("❌ Erro ao apagar: " + erro.message);
  }
}

document.getElementById("data").valueAsDate = new Date();
carregarDados();
</script>

</body>
</html>
